            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "control_plane",
          "note_plane",
          "project_file"
        ],
        "title": "DoctorReport",
        "type": "object"
      }
    }
  ],
  "version": "0.1.0"
}
